  <version>0.1.0</version>
  <description>Independent reverse-parking planning and control module.</description>
  <maintainer email="maintainer@example.com">parking_module maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
