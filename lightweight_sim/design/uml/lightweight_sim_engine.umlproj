    {
      "version": "1.0",
      "name": "Longitudinal Speed DP + QP Flow",
      "diagram_type": "sequence",
      "component_id": "",
      "classes": [],
      "relations": [],
      "lifelines": [
        {
          "id": "life_long_node",
          "name": "node: SpeedPlannerNode",
          "class_ref": "class_speedplannernode",
          "x": 120.0,
          "activations": []
        },
        {
          "id": "life_long_planner",
          "name": "planner: STSpeedPlanner",
          "class_ref": "class_stspeed",
          "x": 480.0,
          "activations": []
        },
        {
          "id": "life_long_dp",
          "name": "dp: StSpeedDpSearcher",
          "class_ref": "class_stspeeddpsearcher",
          "x": 840.0,
          "activations": []
        },
        {
          "id": "life_long_qp",
          "name": "qp: StSpeedQpSmoother",
          "class_ref": "class_stspeedqpsmoother",
          "x": 1200.0,
          "activations": []
        },
        {
          "id": "life_long_osqp",
          "name": "osqp: OSQP",
          "class_ref": "",
          "x": 1560.0,
          "activations": []
        }
      ],
      "messages": [
        {
          "id": "msg_long_req",
          "from_lifeline": "life_long_node",
          "to_lifeline": "life_long_planner",
          "label": "plan(path, state, obstacles, vehicle, target_speed_kmh, max_lateral_accel, destination, closed_route, speed_limits)",
          "type": "sync",
          "order": 1,
          "y": 200.0,
          "note": "消费已确定的几何路径，输出 s(t)/v(t)/a(t)/jerk(t)。"
        },
        {
          "id": "msg_long_input",
          "from_lifeline": "life_long_planner",
          "to_lifeline": "life_long_planner",
          "label": "validate input; reverse_motion / invalid_input / path_exhausted early-out",
          "type": "self",
          "order": 2,
          "y": 270.0,
          "note": "非法输入或倒车直接返回空参考（fail-closed）。"
        },
        {
          "id": "msg_long_geom",
          "from_lifeline": "life_long_planner",
          "to_lifeline": "life_long_planner",
          "label": "RouteGeometry.project -> origin_s; sample 0.25 m curvature/route caps",
          "type": "self",
          "order": 3,
          "y": 336.0,
          "note": "沿路径 0.25 m 计算曲率限速 sqrt(a_lat/kappa)、路段限速与终点。"
        },
        {
          "id": "msg_long_obs",
          "from_lifeline": "life_long_planner",
          "to_lifeline": "life_long_planner",
          "label": "SAT _intersects -> stop line; moving conflict -> unsupported_moving_conflict",
          "type": "self",
          "order": 4,
          "y": 402.0,
          "note": "静态障碍取 min(s)-stop_gap 作为停车线；移动障碍冲突返回无效参考。"
        },
        {
          "id": "msg_long_env",
          "from_lifeline": "life_long_planner",
          "to_lifeline": "life_long_planner",
          "label": "back-propagate braking envelope caps[i]<-min(caps[i], sqrt(caps[i+1]^2+decel*dS)); overspeed recovery",
          "type": "self",
          "order": 5,
          "y": 468.0,
          "note": "先反向传播制动包络，再加超速恢复包络，防止束搜索丢失制动解。"
        },
        {
          "id": "msg_long_dp_call",
          "from_lifeline": "life_long_planner",
          "to_lifeline": "life_long_dp",
          "label": "beam DP over (t, s, v, a) time lattice",
          "type": "sync",
          "order": 6,
          "y": 528.0,
          "note": "DP 在时间格点搜索速度曲线，jerk 对时间求导。"
        },
        {
          "id": "msg_long_dp_step",
          "from_lifeline": "life_long_dp",
          "to_lifeline": "life_long_dp",
          "label": "constant-jerk integrate (s,v,a); v>=0, s<=upper_s, accel bounds, brake consistency",
          "type": "self",
          "order": 7,
          "y": 584.0,
          "note": "7 档 jerk 加 4 个自适应边界动作（到达加速度界、零加速度、两步平稳停车）。"
        },
        {
          "id": "msg_long_dp_beam",
          "from_lifeline": "life_long_dp",
          "to_lifeline": "life_long_dp",
          "label": "quantize (s,v,a), dedupe distinct states, keep fastest-brake; beam_width=96",
          "type": "self",
          "order": 8,
          "y": 650.0,
          "note": "按 (s,v,a) 量化键去重保留不同状态，低速区细分，强制保留最快制动候选。"
        },
        {
          "id": "msg_long_dp_fail",
          "from_lifeline": "life_long_dp",
          "to_lifeline": "life_long_planner",
          "label": "return empty -> dp_infeasible_stepN",
          "type": "return",
          "order": 9,
          "y": 712.0,
          "note": "某层无有效转移即返回空，规划失败关闭。"
        },
        {
          "id": "msg_long_dp_ret",
          "from_lifeline": "life_long_dp",
          "to_lifeline": "life_long_planner",
          "label": "return best (s,v,a) chain as QP seed",
          "type": "return",
          "order": 10,
          "y": 762.0,
          "note": "按代价 argmin 回溯得到状态链，作为 QP 初值与可行走廊。"
        },
        {
          "id": "msg_long_qp_call",
          "from_lifeline": "life_long_planner",
          "to_lifeline": "life_long_qp",
          "label": "build x=[s,v,a,j]; weights + constant-jerk equalities + corridor/speed/accel/jerk/terminal constraints",
          "type": "sync",
          "order": 11,
          "y": 822.0,
          "note": "代价加权跟踪期望速度；终端停车时 s、v 加大权重并约束 v_N=a_N=0。"
        },
        {
          "id": "msg_long_qp_solve",
          "from_lifeline": "life_long_qp",
          "to_lifeline": "life_long_osqp",
          "label": "setup(P=diag(2w), q=-2w*ref, A, l, u); solve()",
          "type": "sync",
          "order": 12,
          "y": 888.0,
          "note": "带迭代精化上限的 OSQP 求解。"
        },
        {
          "id": "msg_long_osqp_ret",
          "from_lifeline": "life_long_osqp",
          "to_lifeline": "life_long_qp",
          "label": "return z, info.status",
          "type": "return",
          "order": 13,
          "y": 938.0,
          "note": "返回解与状态。"
        },
        {
          "id": "msg_long_qp_check",
          "from_lifeline": "life_long_qp",
          "to_lifeline": "life_long_qp",
          "label": "max(A z - [l,u]) <= 2e-3 else qp_constraint_violation",
          "type": "self",
          "order": 14,
          "y": 994.0,
          "note": "约束残差复核，超限判失败。"
        },
        {
          "id": "msg_long_qp_fail",
          "from_lifeline": "life_long_qp",
          "to_lifeline": "life_long_planner",
          "label": "return empty -> qp_<status>",
          "type": "return",
          "order": 15,
          "y": 1054.0,
          "note": "求解失败即返回空错误码，绝不发布未验证轨迹。"
        },
        {
          "id": "msg_long_dense",
          "from_lifeline": "life_long_planner",
          "to_lifeline": "life_long_planner",
          "label": "dense re-validation (9 samples/interval + accel zero-crossing): v>=0, s<=upper_s, accel bounds, v<=qp_limit+0.12",
          "type": "self",
          "order": 16,
          "y": 1110.0,
          "note": "对加速度过零/停车临界点额外采样复核。"
        },
        {
          "id": "msg_long_refine",
          "from_lifeline": "life_long_planner",
          "to_lifeline": "life_long_planner",
          "label": "if invalid: tighten speed upper bounds and re-solve (<=4) else spatial_limit_refinement_failed",
          "type": "self",
          "order": 17,
          "y": 1182.0,
          "note": "按优化后站点重算曲率/限速并 update，迭代精化。"
        },
        {
          "id": "msg_long_ret",
          "from_lifeline": "life_long_planner",
          "to_lifeline": "life_long_node",
          "label": "return SpeedPlan(time, s, v, a, jerk, origin_s, stop_s, 'solved', dp_cost)",
          "type": "return",
          "order": 18,
          "y": 1242.0,
          "note": "仅在残差与稠密校验通过时返回 valid 的速度规划。"
        }
      ],
      "fragments": [
        {
          "id": "frag_long_dp_loop",
          "type": "loop",
          "label": "[for each time step]",
          "x": 450.0,
