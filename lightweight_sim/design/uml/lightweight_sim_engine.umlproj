    {
      "version": "1.0",
      "name": "Horizontal Path DP + QP Flow",
      "diagram_type": "sequence",
      "component_id": "",
      "classes": [],
      "relations": [],
      "lifelines": [
        {
          "id": "life_horiz_planner",
          "name": "planner: DPQPPathPlanner",
          "class_ref": "class_dpqpplanner",
          "x": 120.0,
          "activations": []
        },
        {
          "id": "life_horiz_dp",
          "name": "dp: LateralDpSearcher",
          "class_ref": "class_lateraldpsearcher",
          "x": 460.0,
          "activations": []
        },
        {
          "id": "life_horiz_qp",
          "name": "qp: LateralQpSmoother",
          "class_ref": "class_lateralqpsmoother",
          "x": 800.0,
          "activations": []
        },
        {
          "id": "life_horiz_osqp",
          "name": "osqp: OSQP",
          "class_ref": "",
          "x": 1140.0,
          "activations": []
        }
      ],
      "messages": [
        {
          "id": "msg_horiz_project",
          "from_lifeline": "life_horiz_planner",
          "to_lifeline": "life_horiz_planner",
          "label": "project ego to reference; Frenet start (l0, dl0, ddl0)",
          "type": "self",
          "order": 1,
          "y": 200.0,
          "note": "把车辆投影到全局/局部参考线，得到规划起点横向偏移及其对弧长的一二阶导。"
        },
        {
          "id": "msg_horiz_corridor",
          "from_lifeline": "life_horiz_planner",
          "to_lifeline": "life_horiz_planner",
          "label": "road_bounds + convex_bounds(t, l, offset)",
          "type": "self",
          "order": 2,
          "y": 256.0,
          "note": "按可行驶边界与障碍半长/半宽叠加安全裕度，生成 DP 与 QP 共享的凸走廊。"
        },
        {
          "id": "msg_horiz_dp_call",
          "from_lifeline": "life_horiz_planner",
          "to_lifeline": "life_horiz_dp",
          "label": "searcher.search(stations, lateral_samples, start, preferred, edge_safe, edge_cost)",
          "type": "sync",
          "order": 3,
          "y": 316.0,
          "note": "在弧长-横向格点上做精确 DP：DP 负责找可行拓扑，非连续空间全局最优。"
        },
        {
          "id": "msg_horiz_dp_edge",
          "from_lifeline": "life_horiz_dp",
          "to_lifeline": "life_horiz_dp",
          "label": "quintic_edge(ds, prev, target, samples) -> l, dl, ddl",
          "type": "self",
          "order": 4,
          "y": 372.0,
          "note": "相邻列用五次多项式连接，横向斜率采样 {-0.2, 0, 0.2}（末列固定为 0）。"
        },
        {
          "id": "msg_horiz_dp_safe",
          "from_lifeline": "life_horiz_dp",
          "to_lifeline": "life_horiz_dp",
          "label": "edge_is_safe: 5-point body offsets within convex corridor",
          "type": "self",
          "order": 5,
          "y": 438.0,
          "note": "沿边以 <=0.5 m 求值，校验车身 5 点足迹与 |dl|<=tan(0.35)；不安全边代价置无穷。"
        },
        {
          "id": "msg_horiz_dp_cost",
          "from_lifeline": "life_horiz_dp",
          "to_lifeline": "life_horiz_dp",
          "label": "cost = C(parent) + ds*mean((l-pref)^2 + 20*dl^2 + 100*ddl^2) + clearance",
          "type": "self",
          "order": 6,
          "y": 500.0,
          "note": "递推 C(B)=min_A[C(A)+cost(A->B)]，每个状态只保留最优父节点（精确 DP 剪枝）。"
        },
        {
          "id": "msg_horiz_dp_fail",
          "from_lifeline": "life_horiz_dp",
          "to_lifeline": "life_horiz_planner",
          "label": "return None -> dp_infeasible",
          "type": "return",
          "order": 7,
          "y": 572.0,
          "note": "某列无可行端点或无可达状态时返回 None，规划失败关闭。"
        },
        {
          "id": "msg_horiz_dp_ret",
          "from_lifeline": "life_horiz_dp",
          "to_lifeline": "life_horiz_planner",
          "label": "return best state chain (argmin + backtrack)",
          "type": "return",
          "order": 8,
          "y": 622.0,
          "note": "终点取最低代价，沿父指针回溯得到状态链。"
        },
        {
          "id": "msg_horiz_dense",
          "from_lifeline": "life_horiz_planner",
          "to_lifeline": "life_horiz_dp",
          "label": "searcher.densify(stations, values, samples) -> dp_l; convex_bounds -> lower/upper",
          "type": "sync",
          "order": 9,
          "y": 678.0,
          "note": "用选中的五次多项式增密得 dp_l，并据此构造 QP 走廊与障碍侧向。"
        },
        {
          "id": "msg_horiz_qp_call",
          "from_lifeline": "life_horiz_planner",
          "to_lifeline": "life_horiz_qp",
          "label": "smoother.solve(knots, samples, start, target_profile, lower, upper, road_limits, footprint_constraints, max_slope)",
          "type": "sync",
          "order": 10,
          "y": 738.0,
          "note": "凸 QP：平方代价 + 线性等式/不等式；失败返回 None，绝不产出未验证路径。"
        },
        {
          "id": "msg_horiz_qp_build",
          "from_lifeline": "life_horiz_qp",
          "to_lifeline": "life_horiz_qp",
          "label": "H = 10.1*L^T L + 20*D^T D + 100*A^T A + 10*J^T diag(h) J; q = -L^T(10*dp_l + 0.1*pref)",
          "type": "self",
          "order": 11,
          "y": 794.0,
          "note": "变量 x=[l_0.., dl.., ddl.., j..]，把分段常 jerk 也作为决策变量。"
        },
        {
          "id": "msg_horiz_qp_constr",
          "from_lifeline": "life_horiz_qp",
          "to_lifeline": "life_horiz_qp",
          "label": "E(state integration)=0; initial=start; lower<=L<=upper; |D|<=tan(0.35); road & footprint; |A|<=max_ddl",
          "type": "self",
          "order": 12,
          "y": 866.0,
          "note": "常 jerk 精确积分作等式约束，避免长时域三阶积分病态；走廊/坡度/足迹作不等式。"
        },
        {
          "id": "msg_horiz_qp_solve",
          "from_lifeline": "life_horiz_qp",
          "to_lifeline": "life_horiz_osqp",
          "label": "setup(P, q, C, l, u) + warm_start(dp_l seed); solve()",
          "type": "sync",
          "order": 13,
          "y": 936.0,
          "note": "OSQP 迭代/时间上限、polishing，raise_error=False 后判状态码。"
        },
        {
          "id": "msg_horiz_osqp_ret",
          "from_lifeline": "life_horiz_osqp",
          "to_lifeline": "life_horiz_qp",
          "label": "return x, info.status",
          "type": "return",
          "order": 14,
          "y": 986.0,
          "note": "返回解与求解状态。"
        },
        {
          "id": "msg_horiz_qp_check",
          "from_lifeline": "life_horiz_qp",
          "to_lifeline": "life_horiz_qp",
          "label": "status in {solved, solved inaccurate} and Cx within [l,u]+/-1e-5",
          "type": "self",
          "order": 15,
          "y": 1052.0,
          "note": "约束残差复核；越界或非有限解判为失败。"
        },
        {
          "id": "msg_horiz_qp_fail",
          "from_lifeline": "life_horiz_qp",
          "to_lifeline": "life_horiz_planner",
          "label": "return None -> qp_failed",
          "type": "return",
          "order": 16,
          "y": 1108.0,
          "note": "求解失败/边界非法/残差超限都返回 None。"
        },
        {
          "id": "msg_horiz_qp_ret",
          "from_lifeline": "life_horiz_qp",
          "to_lifeline": "life_horiz_planner",
          "label": "return l, dl, ddl",
          "type": "return",
          "order": 17,
          "y": 1158.0,
          "note": "返回优化后的横向偏移及其导数。"
        },
        {
          "id": "msg_horiz_xy",
          "from_lifeline": "life_horiz_planner",
          "to_lifeline": "life_horiz_planner",
          "label": "Frenet->XY (x, y, theta, kappa); handover boundary exact match",
          "type": "self",
          "order": 18,
          "y": 1214.0,
          "note": "SL 转 XY 并求 heading/曲率；交接段保持已承诺边界精确一致。"
        },
        {
          "id": "msg_horiz_validate",
          "from_lifeline": "life_horiz_planner",
          "to_lifeline": "life_horiz_planner",
          "label": "edge_safe recheck + SAT _trajectory_is_safe + body-corner road check",
          "type": "self",
          "order": 19,
          "y": 1280.0,
          "note": "对结果做几何复核：走廊、矩形 SAT 碰撞、车身四角是否越出道路。"
        },
        {
          "id": "msg_horiz_valid_fail",
          "from_lifeline": "life_horiz_planner",
          "to_lifeline": "life_horiz_planner",
          "label": "return [] (validation_failed / body_outside_road)",
          "type": "self",
          "order": 20,
          "y": 1330.0,
          "note": "任一复核失败即丢弃结果，不发布。"
        },
        {
          "id": "msg_horiz_ok",
          "from_lifeline": "life_horiz_planner",
          "to_lifeline": "life_horiz_planner",
          "label": "store _previous_profile; status=solved; return points",
          "type": "self",
          "order": 21,
          "y": 1380.0,
          "note": "记录本轮剖面用于下轮时间平滑；成功返回路径点。"
        }
      ],
      "fragments": [
