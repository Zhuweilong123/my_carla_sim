          "to_lifeline": "life_plannernode",
          "label": "publish(vehicle/state, obstacles, sim/context)",
          "type": "async",
          "order": 7,
          "y": 506.0,
          "note": "以 sensor_qos 广播状态/障碍物，并锁存 run 上下文。"
        },
        {
