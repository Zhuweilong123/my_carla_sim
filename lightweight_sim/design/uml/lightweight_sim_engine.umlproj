      "messages": [
        {
          "id": "msg_route_request",
          "from_lifeline": "life_simnode",
          "to_lifeline": "life_routingnode",
          "label": "publish routing/request (RouteRequest)",
          "type": "async",
          "order": 1,
          "y": 246.0,
          "note": "每次 run/reset 广播一次任务（起终位姿、地图、闭环绕行）。"
        },
        {
          "id": "msg_route_plan",
          "from_lifeline": "life_routingnode",
          "to_lifeline": "life_reflinenode",
          "label": "publish routing/route (RoutePlan)",
          "type": "async",
          "order": 2,
          "y": 294.0,
          "note": "A* 搜索成功后锁存发布 RoutePlan；失败返回 failure_reason。"
        },
        {
          "id": "msg_reference_line",
          "from_lifeline": "life_reflinenode",
          "to_lifeline": "life_plannernode",
          "label": "publish routing/reference_line",
          "type": "async",
          "order": 3,
          "y": 342.0,
          "note": "ReferenceLineCore 把路由边转成连续参考线与可行驶边界。"
        },
        {
          "id": "msg_step",
          "from_lifeline": "life_simnode",
          "to_lifeline": "life_engine",
          "label": "step(command, dt)",
          "type": "sync",
          "order": 4,
          "y": 390.0,
          "note": "仿真节点按 physics_dt 调用引擎步进，传入限幅后的控制指令。"
        },
        {
          "id": "msg_engine_self",
          "from_lifeline": "life_engine",
          "to_lifeline": "life_engine",
          "label": "substep: steering.advance + ego.step + obstacles.step + collision/offroad/destination check",
          "type": "self",
          "order": 5,
          "y": 452.0,
          "note": "子步推进执行器、自车与障碍物，并做 SAT 碰撞、越界与到点判定。"
        },
        {
          "id": "msg_step_return",
          "from_lifeline": "life_engine",
          "to_lifeline": "life_simnode",
          "label": "return VehicleState",
          "type": "return",
          "order": 6,
          "y": 514.0,
          "note": "返回新的 VehicleState。"
        },
        {
          "id": "msg_publish_state",
          "from_lifeline": "life_simnode",
          "to_lifeline": "life_plannernode",
          "label": "publish(vehicle/state, obstacles, sim/context)",
          "type": "async",
          "order": 7,
          "y": 562.0,
          "note": "以 sensor_qos 广播状态/障碍物，并锁存 run 上下文。"
        },
        {
          "id": "msg_plan",
          "from_lifeline": "life_plannernode",
          "to_lifeline": "life_planner",
          "label": "plan(ego_state, obstacles, pred_loc, vehicle_loc)",
          "type": "sync",
          "order": 8,
          "y": 610.0,
          "note": "最新优先请求：清空旧请求后入队，返回是否被接受。"
        },
        {
          "id": "msg_worker_self",
          "from_lifeline": "life_planner",
          "to_lifeline": "life_planner",
          "label": "_plan(pred_loc, vehicle_loc, obstacles)",
          "type": "self",
          "order": 9,
          "y": 672.0,
          "note": "worker 线程选择安全车道并在走廊内生成 S 型平滑换道轨迹。"
        },
        {
          "id": "msg_plan_return",
          "from_lifeline": "life_planner",
          "to_lifeline": "life_plannernode",
          "label": "return local path (poll_result/get_result)",
          "type": "return",
          "order": 10,
          "y": 734.0,
          "note": "异步结果通过响应队列返回，由轮询取回。"
        },
        {
          "id": "msg_publish_planned",
          "from_lifeline": "life_plannernode",
          "to_lifeline": "life_ctrlnode",
          "label": "publish planned_path",
          "type": "async",
          "order": 11,
          "y": 782.0,
          "note": "锁存发布（带 run/版本编码 sequence）供控制器订阅。"
        },
        {
          "id": "msg_update_ref",
          "from_lifeline": "life_ctrlnode",
          "to_lifeline": "life_veh",
          "label": "update_ref_path(path, reset=False)",
          "type": "sync",
          "order": 12,
          "y": 830.0,
          "note": "只接受当前 run 的 routing/reference_line 与新鲜 planned_path；缺失时由 safe_stop 请求停车。"
        },
        {
          "id": "msg_ctrl_step",
          "from_lifeline": "life_ctrlnode",
          "to_lifeline": "life_veh",
          "label": "step(x, y, phi, vx, vy, r, actual_steer)",
          "type": "sync",
          "order": 13,
          "y": 878.0,
          "note": "控制周期内计算横向转角与纵向油门/刹车。"
        },
        {
          "id": "msg_lat_self",
          "from_lifeline": "life_veh",
          "to_lifeline": "life_veh",
          "label": "lat.control(x, y, phi, vx, vy, r, ref_path)",
          "type": "self",
          "order": 14,
          "y": 940.0,
          "note": "动态 Riccati LQR：预瞄投影匹配 + 曲率前馈与状态反馈。"
        },
        {
          "id": "msg_lon_self",
          "from_lifeline": "life_veh",
          "to_lifeline": "life_veh",
          "label": "lon.control(speed, coupling_accel)",
          "type": "self",
          "order": 15,
          "y": 1002.0,
          "note": "纵向 PID 跟踪目标车速、抵消侧向耦合并限幅加速度。"
        },
        {
          "id": "msg_ctrl_return",
          "from_lifeline": "life_veh",
          "to_lifeline": "life_ctrlnode",
          "label": "return (steer, throttle, brake)",
          "type": "return",
          "order": 16,
          "y": 1064.0,
          "note": "加速度映射为归一化油门/刹车。"
        },
        {
          "id": "msg_publish_command",
          "from_lifeline": "life_ctrlnode",
          "to_lifeline": "life_manager",
          "label": "publish control_command/cruise",
          "type": "async",
          "order": 17,
          "y": 1112.0,
          "note": "控制节点只发布候选命令到私有 topic。"
        },
        {
          "id": "msg_publish_final",
          "from_lifeline": "life_manager",
          "to_lifeline": "life_simnode",
          "label": "publish control_command (arbitrated)",
          "type": "async",
          "order": 18,
          "y": 1160.0,
          "note": "仲裁器是唯一写入 control_command 的节点，闭环回到仿真节点。"
        },
        {
          "id": "msg_command_fresh",
          "from_lifeline": "life_simnode",
          "to_lifeline": "life_engine",
          "label": "step(command, dt)",
          "type": "sync",
          "order": 19,
          "y": 1208.0,
          "note": "命令新鲜（在超时窗口内）时使用收到的控制指令步进。"
        },
        {
          "id": "msg_command_stale",
          "from_lifeline": "life_simnode",
          "to_lifeline": "life_engine",
          "label": "step(ControlCommand(brake=1.0, gear=0), dt)",
          "type": "sync",
          "order": 20,
          "y": 1256.0,
